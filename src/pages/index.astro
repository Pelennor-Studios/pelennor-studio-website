---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pelennor Studio">
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-midnight/80 backdrop-blur-md border-b border-ash/30">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="text-xl font-bold tracking-tight text-pearl font-display">
          PELENNOR
        </a>
        <div class="hidden md:flex items-center gap-8">
          <a href="#films" class="text-sm font-medium text-silver hover:text-pearl transition-colors">Films</a>
          <a href="#about" class="text-sm font-medium text-silver hover:text-pearl transition-colors">About</a>
          <a href="#support" class="text-sm font-medium bg-gold text-midnight px-5 py-2 rounded-sm hover:bg-gold-light transition-colors">Support Us</a>
        </div>
        <button id="mobile-menu-btn" class="md:hidden text-pearl" aria-label="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
    <div id="mobile-menu" class="hidden md:hidden bg-midnight/95 border-t border-ash/30">
      <div class="px-6 py-4 space-y-3">
        <a href="#films" class="block text-sm font-medium text-silver hover:text-pearl">Films</a>
        <a href="#about" class="block text-sm font-medium text-silver hover:text-pearl">About</a>
        <a href="#support" class="block text-sm font-medium bg-gold text-midnight px-5 py-2 rounded-sm text-center">Support Us</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-midnight">
    <div class="absolute inset-0 bg-gradient-to-b from-midnight via-charcoal to-midnight"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 256 256%22><circle cx=%2220%22 cy=%2220%22 r=%221%22 fill=%22white%22/></svg>'); background-size: 40px 40px;"></div>
    
    <div class="relative z-10 text-center px-6 max-w-4xl">
      <div class="mb-8">
        <span class="inline-block text-xs font-semibold tracking-[0.3em] text-gold uppercase mb-6">AI Generative Film Studio</span>
      </div>
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight text-pearl leading-[0.95] mb-8 font-display">
        Stories That<br /><span class="text-gold italic">Endure</span>
      </h1>
      <p class="text-lg md:text-xl text-silver font-light max-w-2xl mx-auto mb-12 leading-relaxed">
        Historical and Christian stories told through the art of AI-generated film. Family-friendly entertainment that honours the past and inspires the future.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#films" class="inline-flex items-center justify-center px-8 py-3.5 bg-pearl text-midnight text-sm font-semibold rounded-sm hover:bg-white transition-colors">
          Our Films
        </a>
        <a href="#support" class="inline-flex items-center justify-center px-8 py-3.5 border border-ash text-pearl text-sm font-semibold rounded-sm hover:border-gold hover:text-gold transition-colors">
          Become a Patron
        </a>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-5 h-5 text-smoke" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
    </div>
  </section>

  <!-- Films -->
  <section id="films" class="py-24 md:py-32 bg-charcoal">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16 md:mb-20">
        <span class="text-xs font-semibold tracking-[0.3em] text-gold uppercase mb-4 block">Coming Soon</span>
        <h2 class="text-4xl md:text-5xl font-bold text-pearl tracking-tight font-display">Our Films</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Film Card: The Scouring of The Shire -->
        <div class="group relative bg-slate rounded-sm overflow-hidden border border-ash/40 hover:border-gold/50 transition-all duration-300">
          <div class="aspect-[2/3] flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-emerald-950 via-emerald-900 to-stone-950"></div>
            <div class="absolute inset-0 flex items-center justify-center opacity-10">
              <svg class="w-48 h-48" viewBox="0 0 100 100" fill="none"><circle cx="50" cy="50" r="35" stroke="currentColor" stroke-width="0.5" class="text-silver"/><path d="M25 65 Q30 40 50 30 Q70 40 75 65 Q65 75 50 80 Q35 75 25 65Z" stroke="currentColor" stroke-width="0.5" fill="currentColor" class="text-silver" opacity="0.3"/></svg>
            </div>
            <div class="relative text-center px-6">
              <div class="w-14 h-14 mx-auto mb-5 rounded-full border border-silver/30 flex items-center justify-center bg-emerald-950/50">
                <svg class="w-6 h-6 text-silver" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9.716 2.253A9.004 9.004 0 0112 3c2.652 0 5.058.972 6.716 2.547M2.284 5.253A9.004 9.004 0 0112 3c2.652 0 5.058.972 6.716 2.547"/></svg>
              </div>
              <h3 class="text-xl font-bold text-pearl mb-2 tracking-tight font-display">The Scouring<br/>of The Shire</h3>
              <p class="text-sm text-smoke font-light">The forgotten chapter -- Hobbits reclaiming home</p>
            </div>
          </div>
          <div class="p-4 flex items-center justify-between">
            <span class="text-xs font-semibold tracking-widest text-gold uppercase">In Development</span>
            <span class="text-xs text-smoke">Tolkien Adaptation</span>
          </div>
        </div>

        <!-- Film Card: Restoring Tolkien -->
        <div class="group relative bg-slate rounded-sm overflow-hidden border border-ash/40 hover:border-gold/50 transition-all duration-300">
          <div class="aspect-[2/3] flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-indigo-950 via-slate-900 to-stone-950"></div>
            <div class="absolute inset-0 flex items-center justify-center opacity-10">
              <svg class="w-48 h-48" viewBox="0 0 100 100" fill="none"><rect x="25" y="20" width="50" height="60" rx="3" stroke="currentColor" stroke-width="0.5" class="text-silver"/><line x1="35" y1="35" x2="65" y2="35" stroke="currentColor" stroke-width="0.3" class="text-silver"/><line x1="35" y1="45" x2="60" y2="45" stroke="currentColor" stroke-width="0.3" class="text-silver"/><line x1="35" y1="55" x2="55" y2="55" stroke="currentColor" stroke-width="0.3" class="text-silver"/></svg>
            </div>
            <div class="relative text-center px-6">
              <div class="w-14 h-14 mx-auto mb-5 rounded-full border border-silver/30 flex items-center justify-center bg-indigo-950/50">
                <svg class="w-6 h-6 text-silver" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18c-2.305 0-4.408.867-6 2.292m0-14.25v14.25"/></svg>
              </div>
              <h3 class="text-xl font-bold text-pearl mb-2 tracking-tight font-display">Restoring<br/>Tolkien</h3>
              <p class="text-sm text-smoke font-light">Reclaiming the author from his interpreters</p>
            </div>
          </div>
          <div class="p-4 flex items-center justify-between">
            <span class="text-xs font-semibold tracking-widest text-gold uppercase">In Development</span>
            <span class="text-xs text-smoke">Documentary</span>
          </div>
        </div>

        <!-- Film Card: The Dragon and The Raven -->
        <div class="group relative bg-slate rounded-sm overflow-hidden border border-ash/40 hover:border-gold/50 transition-all duration-300">
          <div class="aspect-[2/3] flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-red-950 via-amber-950 to-stone-950"></div>
            <div class="absolute inset-0 flex items-center justify-center opacity-10">
              <svg class="w-48 h-48" viewBox="0 0 100 100" fill="none"><path d="M30 70 L50 25 L70 70 L55 70 L55 80 L45 80 L45 70 Z" stroke="currentColor" stroke-width="0.5" class="text-silver"/><path d="M42 50 L50 30 L58 50" stroke="currentColor" stroke-width="0.5" fill="currentColor" class="text-silver" opacity="0.3"/></svg>
            </div>
            <div class="relative text-center px-6">
              <div class="w-14 h-14 mx-auto mb-5 rounded-full border border-silver/30 flex items-center justify-center bg-red-950/50">
                <svg class="w-6 h-6 text-silver" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18a3.75 3.75 0 00.495-7.287 3.75 3.75 0 00-4.49 4.49A3.75 3.75 0 0012 18z"/></svg>
              </div>
              <h3 class="text-xl font-bold text-pearl mb-2 tracking-tight font-display">The Dragon<br/>and The Raven</h3>
              <p class="text-sm text-smoke font-light">Alfred the Great and the making of England</p>
            </div>
          </div>
          <div class="p-4 flex items-center justify-between">
            <span class="text-xs font-semibold tracking-widest text-gold uppercase">In Development</span>
            <span class="text-xs text-smoke">Historical Epic</span>
          </div>
        </div>

        <!-- Film Card: The Reformation in England -->
        <div class="group relative bg-slate rounded-sm overflow-hidden border border-ash/40 hover:border-gold/50 transition-all duration-300">
          <div class="aspect-[2/3] flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-stone-900 via-neutral-900 to-stone-950"></div>
            <div class="absolute inset-0 flex items-center justify-center opacity-10">
              <svg class="w-48 h-48" viewBox="0 0 100 100" fill="none"><path d="M50 15 L53 40 L75 35 L57 50 L75 65 L53 60 L50 85 L47 60 L25 65 L43 50 L25 35 L47 40 Z" stroke="currentColor" stroke-width="0.5" class="text-silver" fill="currentColor" opacity="0.15"/></svg>
            </div>
            <div class="relative text-center px-6">
              <div class="w-14 h-14 mx-auto mb-5 rounded-full border border-silver/30 flex items-center justify-center bg-stone-900/50">
                <svg class="w-6 h-6 text-silver" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18c-2.305 0-4.408.867-6 2.292m0-14.25v14.25"/></svg>
              </div>
              <h3 class="text-xl font-bold text-pearl mb-2 tracking-tight font-display">The Reformation<br/>in England</h3>
              <p class="text-sm text-smoke font-light">When the Word broke through</p>
            </div>
          </div>
          <div class="p-4 flex items-center justify-between">
            <span class="text-xs font-semibold tracking-widest text-gold uppercase">In Development</span>
            <span class="text-xs text-smoke">Historical Drama</span>
          </div>
        </div>

        <!-- Film Card: Pilgrim's Progress -->
        <div class="group relative bg-slate rounded-sm overflow-hidden border border-ash/40 hover:border-gold/50 transition-all duration-300">
          <div class="aspect-[2/3] flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-sky-950 via-blue-950 to-stone-950"></div>
            <div class="absolute inset-0 flex items-center justify-center opacity-10">
              <svg class="w-48 h-48" viewBox="0 0 100 100" fill="none"><path d="M30 80 L45 50 L55 60 L75 20" stroke="currentColor" stroke-width="0.8" class="text-silver"/><circle cx="75" cy="20" r="3" fill="currentColor" class="text-silver" opacity="0.3"/></svg>
            </div>
            <div class="relative text-center px-6">
              <div class="w-14 h-14 mx-auto mb-5 rounded-full border border-silver/30 flex items-center justify-center bg-sky-950/50">
                <svg class="w-6 h-6 text-silver" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"/></svg>
              </div>
              <h3 class="text-xl font-bold text-pearl mb-2 tracking-tight font-display">Pilgrim's<br/>Progress</h3>
              <p class="text-sm text-smoke font-light">The journey from this world to that which is to come</p>
            </div>
          </div>
          <div class="p-4 flex items-center justify-between">
            <span class="text-xs font-semibold tracking-widest text-gold uppercase">In Development</span>
            <span class="text-xs text-smoke">Allegorical Epic</span>
          </div>
        </div>

        <!-- Film Card: The Word of The Lord -->
        <div class="group relative bg-slate rounded-sm overflow-hidden border border-ash/40 hover:border-gold/50 transition-all duration-300">
          <div class="aspect-[2/3] flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-amber-950 via-yellow-950 to-stone-950"></div>
            <div class="absolute inset-0 flex items-center justify-center opacity-10">
              <svg class="w-48 h-48" viewBox="0 0 100 100" fill="none"><path d="M40 70 L50 20 L60 70 M35 85 Q50 75 65 85" stroke="currentColor" stroke-width="0.5" class="text-silver"/><circle cx="50" cy="18" r="4" fill="currentColor" class="text-silver" opacity="0.3"/></svg>
            </div>
            <div class="relative text-center px-6">
              <div class="w-14 h-14 mx-auto mb-5 rounded-full border border-silver/30 flex items-center justify-center bg-amber-950/50">
                <svg class="w-6 h-6 text-silver" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 13.5l10.5-11.25L21 7.5l-3.75 3.75L21 15l-10.5-3.75L3.75 13.5z"/></svg>
              </div>
              <h3 class="text-xl font-bold text-pearl mb-2 tracking-tight font-display">The Word<br/>of The Lord</h3>
              <p class="text-sm text-smoke font-light">How Scripture shaped a nation</p>
            </div>
          </div>
          <div class="p-4 flex items-center justify-between">
            <span class="text-xs font-semibold tracking-widest text-gold uppercase">In Development</span>
            <span class="text-xs text-smoke">Historical Epic</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="py-24 md:py-32 bg-midnight">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs font-semibold tracking-[0.3em] text-gold uppercase mb-4 block">Who We Are</span>
          <h2 class="text-4xl md:text-5xl font-bold text-pearl tracking-tight mb-6 font-display">About Pelennor</h2>
        </div>

        <div class="space-y-6 text-silver text-lg leading-relaxed font-light">
          <p>
            Pelennor Studio is an AI generative film studio dedicated to telling the stories that matter most -- historical epics and Christian narratives that have shaped civilisations and inspired generations.
          </p>
          <p>
            We believe the greatest stories ever told deserve to be told again, with reverence and excellence, using the most advanced creative tools available. Every film we produce is crafted with families and children in mind -- entertainment that honours the past and inspires the future.
          </p>
        </div>

        <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-gold/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18c-2.305 0-4.408.867-6 2.292m0-14.25v14.25"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-pearl uppercase tracking-wider mb-2 font-display">Historical</h3>
            <p class="text-sm text-smoke font-light">Faithful to the real stories of the past, not modern revisions</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-gold/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-pearl uppercase tracking-wider mb-2 font-display">Christian</h3>
            <p class="text-sm text-smoke font-light">Stories that reflect faith, hope, and redemption</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-gold/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.972m.94 3.198l.001.005a3.75 3.75 0 01-7.499 0m7.498 3.198c.186 1.098.568 2.163 1.208 3.163a11.952 11.952 0 01-3.814-1.726m4.605-3.637a3.75 3.75 0 01-7.5 0m7.5 0c.186 1.098.568 2.163 1.208 3.163M12 3v3m0 12v3m9-6h-3M6 15H3m0-6h3m9-3V3M3 9v6m15-3h3"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-pearl uppercase tracking-wider mb-2 font-display">Family</h3>
            <p class="text-sm text-smoke font-light">Safe for children, meaningful for adults, excellent for all</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Patreon Support -->
  <section id="support" class="py-24 md:py-32 bg-gradient-to-b from-charcoal to-midnight">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="relative bg-slate border border-gold/30 rounded-sm overflow-hidden">
          <div class="h-1 bg-gradient-to-r from-gold-dark via-gold to-gold-dark"></div>
          
          <div class="p-8 md:p-12 lg:p-16">
            <div class="text-center mb-10">
              <span class="text-xs font-semibold tracking-[0.3em] text-gold uppercase mb-4 block">Join the Journey</span>
              <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-pearl tracking-tight mb-4 font-display">Support Our Films</h2>
              <p class="text-lg text-silver font-light max-w-2xl mx-auto">
                Every great story needs patrons. Become part of the Pelennor community and help us bring these stories to life.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
              <div class="bg-charcoal border border-ash/50 rounded-sm p-6 text-center hover:border-gold/40 transition-colors">
                <span class="text-xs font-semibold tracking-widest text-smoke uppercase mb-3 block">Subscriber</span>
                <div class="text-3xl font-bold text-pearl mb-1">&pound;3<span class="text-sm font-normal text-smoke">/mo</span></div>
                <p class="text-sm text-silver font-light mt-3">Early access to trailers and previews</p>
              </div>
              <div class="bg-charcoal border border-gold/50 rounded-sm p-6 text-center relative hover:border-gold transition-colors">
                <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                  <span class="bg-gold text-midnight text-xs font-bold px-3 py-1 rounded-sm uppercase tracking-wider">Popular</span>
                </div>
                <span class="text-xs font-semibold tracking-widest text-gold uppercase mb-3 block mt-1">Patron</span>
                <div class="text-3xl font-bold text-pearl mb-1">&pound;8<span class="text-sm font-normal text-smoke">/mo</span></div>
                <p class="text-sm text-silver font-light mt-3">Early access + behind-the-scenes progress updates</p>
              </div>
              <div class="bg-charcoal border border-ash/50 rounded-sm p-6 text-center hover:border-gold/40 transition-colors">
                <span class="text-xs font-semibold tracking-widest text-smoke uppercase mb-3 block">Producer</span>
                <div class="text-3xl font-bold text-pearl mb-1">&pound;20<span class="text-sm font-normal text-smoke">/mo</span></div>
                <p class="text-sm text-silver font-light mt-3">All benefits + exclusive director's commentary and artbook</p>
              </div>
            </div>

            <div class="text-center">
              <a href="https://www.patreon.com" target="_blank" rel="noopener noreferrer" 
                 class="inline-flex items-center justify-center px-10 py-4 bg-gold text-midnight text-sm font-bold rounded-sm hover:bg-gold-light transition-colors tracking-wide uppercase">
