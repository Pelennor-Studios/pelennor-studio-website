---
import Layout from '../layouts/Layout.astro';

const films = [
  {
    title: 'The Scouring of The Shire',
    subtitle: 'The forgotten chapter',
    description: 'The Hobbits return home to find it overrun -- and must reclaim it by their own hand.',
    genre: 'Tolkien Adaptation',
    gradient: 'from-emerald-900 via-emerald-800 to-stone-900',
  },
  {
    title: 'Restoring Tolkien',
    subtitle: 'Reclaiming the author',
    description: 'Separating the man from the mythmakers -- a documentary reclaiming Tolkien\'s true vision.',
    genre: 'Documentary',
    gradient: 'from-indigo-900 via-slate-800 to-stone-900',
  },
  {
    title: 'The Dragon and The Raven',
    subtitle: 'Alfred the Great',
    description: 'A young king defends his kingdom against Viking invaders and forges a nation from the flames.',
    genre: 'Historical Epic',
    gradient: 'from-red-950 via-red-900 to-stone-900',
  },
  {
    title: 'The Reformation in England',
    subtitle: 'When the Word broke through',
    description: 'The dangerous story of how scripture crossed the Channel and set a nation ablaze.',
    genre: 'Historical Drama',
    gradient: 'from-stone-800 via-neutral-800 to-stone-900',
  },
  {
    title: "Pilgrim's Progress",
    subtitle: 'The journey beyond',
    description: 'Christian leaves the City of Destruction -- an allegory that has inspired readers for three centuries.',
    genre: 'Allegorical Epic',
    gradient: 'from-sky-950 via-sky-900 to-stone-900',
  },
  {
    title: 'The Word of The Lord',
    subtitle: 'How Scripture shaped a nation',
    description: 'From parchment to pulpit to people -- the untold story of how the English Bible changed everything.',
    genre: 'Historical Epic',
    gradient: 'from-amber-900 via-yellow-900 to-stone-900',
  },
];
---

<Layout title="Pelennor Studio">
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-graphite/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="#" class="text-xl font-bold tracking-tight text-ink font-display">
          PELENNOR
        </a>
        <div class="hidden md:flex items-center gap-8">
          <a href="#films" class="text-sm font-medium text-smoke hover:text-ink transition-colors">Films</a>
          <a href="#about" class="text-sm font-medium text-smoke hover:text-ink transition-colors">About</a>
          <a href="#support" class="text-sm font-medium bg-ink text-white px-5 py-2 rounded-sm hover:bg-graphite transition-colors">Support Us</a>
        </div>
        <button id="mobile-menu-btn" class="md:hidden text-ink" aria-label="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
    <div id="mobile-menu" class="hidden md:hidden bg-white/95 border-t border-graphite/10">
      <div class="px-6 py-4 space-y-3">
        <a href="#films" class="block text-sm font-medium text-smoke hover:text-ink">Films</a>
        <a href="#about" class="block text-sm font-medium text-smoke hover:text-ink">About</a>
        <a href="#support" class="block text-sm font-medium bg-ink text-white px-5 py-2 rounded-sm text-center">Support Us</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-white">
    <div class="relative z-10 text-center px-6 max-w-4xl">
      <div class="mb-8">
        <span class="inline-block text-xs font-semibold tracking-[0.3em] text-accent uppercase mb-6">AI Generative Film Studio</span>
      </div>
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight text-ink leading-[0.95] mb-8 font-display">
        Stories That<br /><span class="text-accent italic">Endure</span>
      </h1>
      <p class="text-lg md:text-xl text-smoke font-light max-w-2xl mx-auto mb-12 leading-relaxed">
        Historical and Christian stories told through the art of AI-generated film. Family-friendly entertainment that honours the past and inspires the future.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#films" class="inline-flex items-center justify-center px-8 py-3.5 bg-ink text-white text-sm font-semibold rounded-sm hover:bg-graphite transition-colors">
          Our Films
        </a>
        <a href="#support" class="inline-flex items-center justify-center px-8 py-3.5 border border-graphite/30 text-ink text-sm font-semibold rounded-sm hover:border-ink hover:bg-ink hover:text-white transition-colors">
          Become a Patron
        </a>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-5 h-5 text-smoke/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
    </div>
  </section>

  <!-- Films -- Full-screen slides -->
  <section id="films">
    {films.map((film, i) => (
      <div class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br {film.gradient}">
        <!-- Subtle background pattern -->
        <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
        
        <div class="relative z-10 text-center px-6 max-w-3xl">
          <span class="inline-block text-xs font-semibold tracking-[0.3em] text-white/60 uppercase mb-4">{film.genre}</span>
          <h2 class="text-5xl md:text-7xl lg:text-8xl font-bold text-white tracking-tight leading-[0.95] mb-4 font-display">
            {film.title}
          </h2>
          <p class="text-lg md:text-xl text-white/70 font-light italic mb-6 font-display">{film.subtitle}</p>
          <p class="text-base md:text-lg text-white/50 font-light max-w-xl mx-auto leading-relaxed">
            {film.description}
          </p>
          <div class="mt-10">
            <span class="inline-block text-xs font-semibold tracking-[0.2em] text-white/40 uppercase border border-white/20 px-4 py-2 rounded-sm">Coming Soon</span>
          </div>
        </div>

        <!-- Slide number -->
        <div class="absolute bottom-8 right-8 text-white/20 text-sm font-display">
          {String(i + 1).padStart(2, '0')} / {String(films.length).padStart(2, '0')}
        </div>
      </div>
    ))}
  </section>

  <!-- About -->
  <section id="about" class="py-24 md:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs font-semibold tracking-[0.3em] text-accent uppercase mb-4 block">Who We Are</span>
          <h2 class="text-4xl md:text-5xl font-bold text-ink tracking-tight mb-6 font-display">About Pelennor</h2>
        </div>

        <div class="space-y-6 text-smoke text-lg leading-relaxed font-light">
          <p>
            Pelennor Studio is an AI generative film studio dedicated to telling the stories that matter most -- historical epics and Christian narratives that have shaped civilisations and inspired generations.
          </p>
          <p>
            We believe the greatest stories ever told deserve to be told again, with reverence and excellence, using the most advanced creative tools available. Every film we produce is crafted with families and children in mind -- entertainment that honours the past and inspires the future.
          </p>
        </div>

        <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-ink/5 flex items-center justify-center">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18c-2.305 0-4.408.867-6 2.292m0-14.25v14.25"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-ink uppercase tracking-wider mb-2 font-display">Historical</h3>
            <p class="text-sm text-smoke font-light">Faithful to the real stories of the past, not modern revisions</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-ink/5 flex items-center justify-center">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-ink uppercase tracking-wider mb-2 font-display">Christian</h3>
            <p class="text-sm text-smoke font-light">Stories that reflect faith, hope, and redemption</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-ink/5 flex items-center justify-center">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.972m.94 3.198l.001.005a3.75 3.75 0 01-7.499 0m7.498 3.198c.186 1.098.568 2.163 1.208 3.163a11.952 11.952 0 01-3.814-1.726m4.605-3.637a3.75 3.75 0 01-7.5 0m7.5 0c.186 1.098.568 2.163 1.208 3.163M12 3v3m0 12v3m9-6h-3M6 15H3m0-6h3m9-3V3M3 9v6m15-3h3"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-ink uppercase tracking-wider mb-2 font-display">Family</h3>
            <p class="text-sm text-smoke font-light">Safe for children, meaningful for adults, excellent for all</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Patreon Support -->
  <section id="support" class="py-24 md:py-32 bg-snow">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="relative bg-white border border-graphite/15 rounded-sm overflow-hidden shadow-sm">
          <div class="h-1 bg-ink"></div>
          
          <div class="p-8 md:p-12 lg:p-16">
            <div class="text-center mb-10">
              <span class="text-xs font-semibold tracking-[0.3em] text-accent uppercase mb-4 block">Join the Journey</span>
              <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-ink tracking-tight mb-4 font-display">Support Our Films</h2>
              <p class="text-lg text-smoke font-light max-w-2xl mx-auto">
                Every great story needs patrons. Become part of the Pelennor community and help us bring these stories to life.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
              <div class="bg-snow border border-graphite/10 rounded-sm p-6 text-center hover:border-accent/30 transition-colors">
                <span class="text-xs font-semibold tracking-widest text-smoke uppercase mb-3 block">Subscriber</span>
                <div class="text-3xl font-bold text-ink mb-1 font-display">&pound;3<span class="text-sm font-normal text-smoke font-body">/mo</span></div>
                <p class="text-sm text-smoke font-light mt-3">Early access to trailers and previews</p>
              </div>
              <div class="bg-ink text-white border border-ink rounded-sm p-6 text-center relative">
                <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                  <span class="bg-white text-ink text-xs font-bold px-3 py-1 rounded-sm uppercase tracking-wider">Popular</span>
                </div>
                <span class="text-xs font-semibold tracking-widest text-white/70 uppercase mb-3 block mt-1">Patron</span>
                <div class="text-3xl font-bold mb-1 font-display">&pound;8<span class="text-sm font-normal text-white/60 font-body">/mo</span></div>
                <p class="text-sm text-white/70 font-light mt-3">Early access + behind-the-scenes progress updates</p>
              </div>
              <div class="bg-snow border border-graphite/10 rounded-sm p-6 text-center hover:border-accent/30 transition-colors">
                <span class="text-xs font-semibold tracking-widest text-smoke uppercase mb-3 block">Producer</span>
                <div class="text-3xl font-bold text-ink mb-1 font-display">&pound;20<span class="text-sm font-normal text-smoke font-body">/mo</span></div>
                <p class="text-sm text-smoke font-light mt-3">All benefits + exclusive director's commentary and artbook</p>
              </div>
            </div>

            <div class="text-center">
              <a href="https://www.patreon.com" target="_blank" rel="noopener noreferrer" 
                 class="inline-flex items-center justify-center px-10 py-4 bg-ink text-white text-sm font-bold rounded-sm hover:bg-graphite transition-colors tracking-wide uppercase">
                <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="currentColor"><path d="M15.386.525C12.556.525 10.062 2.4 9.14 5.058c-.536 1.54-.385 3.208.378 4.647.763 1.44 2.1 2.456 3.658 2.857.78.2 1.592.246 2.39.136.8-.11 1.578-.39 2.276-.826 1.4-.875 2.378-2.26 2.756-3.897.378-1.636.15-3.318-.646-4.786C19.66 1.72 18.28.74 16.59.367 16.2.28 15.792.242 15.386.242V.525zM4.072 3.37C3.19 3.37 2.4 3.9 2.075 4.724c-.324.824-.145 1.758.456 2.41.602.65 1.507.86 2.323.57.816-.29 1.386-1.048 1.478-1.91.092-.862-.324-1.7-1.065-2.163-.37-.23-.793-.353-1.224-.353l.03-.108z"/></svg>
                Become a Patron
              </a>
              <p class="text-xs text-smoke mt-4 font-light">Cancel anytime. Every pound goes directly toward production.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-12 bg-ink text-white/40">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="text-sm font-light">
          &copy; 2025 Pelennor Studio. All rights reserved.
        </div>
        <div class="flex items-center gap-6">
          <a href="https://www.patreon.com" target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white/70 transition-colors" aria-label="Patreon">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M15.386.525C12.556.525 10.062 2.4 9.14 5.058c-.536 1.54-.385 3.208.378 4.647.763 1.44 2.1 2.456 3.658 2.857.78.2 1.592.246 2.39.136.8-.11 1.578-.39 2.276-.826 1.4-.875 2.378-2.26 2.756-3.897.378-1.636.15-3.318-.646-4.786C19.66 1.72 18.28.74 16.59.367 16.2.28 15.792.242 15.386.242V.525zM4.072 3.37C3.19 3.37 2.4 3.9 2.075 4.724c-.324.824-.145 1.758.456 2.41.602.65 1.507.86 2.323.57.816-.29 1.386-1.048 1.478-1.91.092-.862-.324-1.7-1.065-2.163-.37-.23-.793-.353-1.224-.353l.03-.108z"/></svg>
          </a>
          <a href="https://github.com/Pelennor-Studios" target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white/70 transition-colors" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    menuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
    mobileMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
      });
    });
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.querySelector(anchor.getAttribute('href'));
        target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  </script>
</Layout>